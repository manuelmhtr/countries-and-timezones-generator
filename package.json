{
  "private": true,
  "name": "countries-and-timezones-generator",
  "version": "2.0.0",
  "description": "Generates raw data necessary for the \"countries-and-timezones\" package.",
  "main": "lib/index.ts",
  "scripts": {
    "lint:html": "prettier --write \"**/*.html\"",
    "lint:ts": "xo --fix",
    "lint:json": "prettier --write \"**/*.json\"",
    "lint:md": "markdownlint \"**/*.md\" --fix --dot --ignore-path .gitignore && prettier --write \"**/*.md\"",
    "lint": "yarn run lint:ts && yarn run lint:html && yarn run lint:json && yarn run lint:md",
    "start": "tsx lib/index.ts",
    "test": "vitest",
    "postinstall": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manuelmhtr/countries-and-timezones-generator.git"
  },
  "author": "Manuel de la Torre",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/manuelmhtr/countries-and-timezones-generator/issues"
  },
  "homepage": "https://github.com/manuelmhtr/countries-and-timezones-generator#readme",
  "mocha": {
    "bail": true,
    "exit": true,
    "recursive": true,
    "fullTrace": true,
    "timeout": 5000,
    "ui": "bdd"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "lodash-es": "^4.17.21"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.14.1",
    "@typescript-eslint/parser": "^8.29.1",
    "countries-and-timezones": "^3.7.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.1",
    "markdownlint-cli": "^0.42.0",
    "mocha": "11.1.0",
    "tsx": "^4.19.3",
    "type-fest": "^4.39.1",
    "typescript": "^5.8.3",
    "vite": "^6.2.6",
    "vitest": "^3.1.1",
    "xo": "^0.59.3"
  },
  "engines": {
    "node": ">= 22.6.0 && <=23.0.0",
    "yarn": "^4.6.0"
  }
}
